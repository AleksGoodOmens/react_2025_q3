# Указывает, что это корневой файл (настройки применяются рекурсивно ко всему проекту)
root = true

# Настройки для всех файлов
[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Настройки только для JSON-файлов
[*.json]
indent_size = 2

# Настройки для Markdown-файлов
[*.md]
trim_trailing_whitespace = false  # чтобы не удалять пробелы в разметке